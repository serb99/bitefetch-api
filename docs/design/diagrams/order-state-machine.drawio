<mxfile host="drawio">
  <diagram id="os" name="Order status">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="os-root0"/>
        <mxCell id="os-root1" parent="os-root0"/>
        <mxCell id="os-1" value="&lt;b&gt;PENDING_PAYMENT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;waiting for card authorization&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="os-root1"><mxGeometry x="160" y="260" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-2" value="&lt;b&gt;PLACED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;paid (authorized), awaiting restaurant&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="os-root1"><mxGeometry x="460" y="260" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-3" value="&lt;b&gt;ACCEPTED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;preparing · prep time set&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="os-root1"><mxGeometry x="760" y="260" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-4" value="&lt;b&gt;READY_FOR_PICKUP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;food at the counter&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="os-root1"><mxGeometry x="1060" y="260" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-5" value="&lt;b&gt;PICKED_UP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;courier has the food&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="os-root1"><mxGeometry x="1360" y="260" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-6" value="&lt;b&gt;DELIVERED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;payment captured&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="os-root1"><mxGeometry x="1660" y="260" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-7" value="&lt;b&gt;EXPIRED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;never paid · authorization voided&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;" vertex="1" parent="os-root1"><mxGeometry x="160" y="80" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-8" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;owner declined or no answer · voided&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="os-root1"><mxGeometry x="460" y="80" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="os-9" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;authorization voided · cancelled_by + cancel_reason recorded&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="os-root1"><mxGeometry x="160" y="500" width="1380" height="64" as="geometry"/></mxCell>
        <mxCell id="os-10" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="os-root1"><mxGeometry x="60" y="270.4" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="os-11" value="T1 customer&lt;br&gt;places order" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-10" target="os-1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-12" value="T2 card declined,&lt;br&gt;customer retries" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-1" target="os-1"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="178" y="358"/><mxPoint x="126" y="358"/><mxPoint x="126" y="314"/></Array><mxPoint x="-40" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="os-13" value="T3 Stripe webhook:&lt;br&gt;authorized" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-1" target="os-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-14" value="T6 owner accepts&lt;br&gt;+ prep time" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-2" target="os-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-15" value="T10 owner&lt;br&gt;marks ready" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-3" target="os-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-16" value="T12 courier at&lt;br&gt;restaurant *" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-4" target="os-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-17" value="T13 courier at&lt;br&gt;address *" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-5" target="os-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-18" value="T4 15 min unpaid&lt;br&gt;(system)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-1" target="os-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-19" value="T7 owner rejects&lt;br&gt;T8 5 min no answer (system)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-2" target="os-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-20" value="T12 courier picks up before owner taps ready *" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-3" target="os-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850.0" y="200"/><mxPoint x="1450.0" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="os-21" value="T5 customer abandons&lt;br&gt;T15 admin" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.0652;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-1" target="os-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-22" value="T9 customer&lt;br&gt;T15 admin" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2826;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-2" target="os-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-23" value="T11 owner (reason) · T15 admin&lt;br&gt;T18 customer if no courier found" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-3" target="os-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-24" value="T14 admin (owner request) · T15 admin&lt;br&gt;T18 customer if no courier found" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7174;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-4" target="os-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-25" value="T15 admin" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9348;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-5" target="os-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="os-26" value="BiteFetch – Order status" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="os-root1"><mxGeometry x="40" y="10" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="os-27" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;• Thick border = terminal status (never left again).&lt;br&gt;• T-numbers match the transition table in docs/design/notes/order-state-machine.md.&lt;br&gt;• * Courier must be within 150 m (server-side check). Dashed grey arrows = admin acts for the courier (T16, T17).&lt;br&gt;• T1 guard: restaurant open and not paused · items available at this restaurant · address in range · fresh courier within 10 km · totals recomputed on the server.&lt;br&gt;• Every arrow is one conditional UPDATE … WHERE status = &amp;lt;from&amp;gt;. Side effects go to the outbox.&lt;br&gt;• Courier dispatch runs in parallel while ACCEPTED / READY_FOR_PICKUP – see the &lt;i&gt;Dispatch&lt;/i&gt; page.&lt;br&gt;• Payment: authorized at checkout, captured on DELIVERED, so every cancel is a void.&lt;br&gt;• T18 (added later): the customer may cancel while dispatch_state = no_courier and no courier is assigned." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="os-root1"><mxGeometry x="160" y="620" width="760" height="190" as="geometry"/></mxCell>
        <mxCell id="os-28" value="T16 admin&lt;br&gt;(for courier)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-4" target="os-5"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="os-29" value="T16 admin marks picked up for the courier" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-3" target="os-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="814.0" y="160"/><mxPoint x="1486.0" y="160"/></Array></mxGeometry></mxCell>
        <mxCell id="os-30" value="T17 admin&lt;br&gt;(for courier)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;strokeColor=#888888;fontColor=#555555;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="os-root1" source="os-5" target="os-6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ds" name="Dispatch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="ds-root0"/>
        <mxCell id="ds-root1" parent="ds-root0"/>
        <mxCell id="ds-1" value="&lt;b&gt;not_started&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;waiting for dispatch_after&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="ds-root1"><mxGeometry x="140" y="200" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="ds-2" value="&lt;b&gt;searching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;offering one courier at a time&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="ds-root1"><mxGeometry x="460" y="200" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="ds-3" value="&lt;b&gt;assigned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;orders.courier_id set&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="ds-root1"><mxGeometry x="820" y="200" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="ds-4" value="&lt;b&gt;no_courier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;admin alerted · still offers new couriers&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="ds-root1"><mxGeometry x="460" y="440" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="ds-5" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="ds-root1"><mxGeometry x="60" y="220.0" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="ds-6" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="ds-root1"><mxGeometry x="1150" y="217.0" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="ds-7" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-5" target="ds-1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-8" value="order accepted (T6)" style="text;html=1;fontSize=10;fontColor=#555555;align=center;" vertex="1" parent="ds-root1"><mxGeometry x="30" y="246.0" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="ds-9" value="S1 dispatch_after&lt;br&gt;reached (worker)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-1" target="ds-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-10" value="S2–S4 offer nearest courier;&lt;br&gt;declined or 30 s timeout → next one" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-2" target="ds-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="150"/><mxPoint x="610" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="ds-11" value="S5 courier accepts" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-2" target="ds-3"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ds-12" value="S8 admin reassigns" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-3" target="ds-2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ds-13" value="order picked up&lt;br&gt;(T12 / T16)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-3" target="ds-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-14" value="S6 15 min, nobody&lt;br&gt;accepted" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-2" target="ds-4"><mxGeometry relative="1" as="geometry"><mxPoint x="-60" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ds-15" value="S7 admin retry&lt;br&gt;(new round)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-4" target="ds-2"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ds-16" value="S5 newly online courier accepts" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-4" target="ds-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-17" value="BiteFetch – Courier dispatch (orders.dispatch_state)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="ds-root1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="ds-18" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Runs in parallel with the order status while ACCEPTED or READY_FOR_PICKUP.&lt;br&gt;• Order cancelled or rejected at any point → pending offer withdrawn, courier released, dispatch ends (same transaction).&lt;br&gt;• Dashed arrow = admin action (needs reason + matching version).&lt;br&gt;• Nearest courier to the &lt;b&gt;restaurant&lt;/b&gt;, radius 3 → 6 → 10 km, never someone already asked this round." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ds-root1"><mxGeometry x="980" y="400" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="ds-19" value="order_offers.status – one row per courier asked" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="ds-root1"><mxGeometry x="60" y="590" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="ds-20" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="ds-root1"><mxGeometry x="60" y="748" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="ds-21" value="&lt;b&gt;pending&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;expires_at = offered_at + 30 s&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="ds-root1"><mxGeometry x="140" y="728" width="180" height="64" as="geometry"/></mxCell>
        <mxCell id="ds-22" value="S2" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-20" target="ds-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-23" value="&lt;b&gt;accepted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;courier is assigned&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="ds-root1"><mxGeometry x="640" y="640" width="180" height="54" as="geometry"/></mxCell>
        <mxCell id="ds-24" value="S5 courier accepts before expires_at" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-21" target="ds-23"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-25" value="&lt;b&gt;declined&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;next courier is offered&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;" vertex="1" parent="ds-root1"><mxGeometry x="640" y="720" width="180" height="54" as="geometry"/></mxCell>
        <mxCell id="ds-26" value="S3 courier declines or goes offline" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-21" target="ds-25"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-27" value="&lt;b&gt;expired&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;next courier is offered&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;" vertex="1" parent="ds-root1"><mxGeometry x="640" y="800" width="180" height="54" as="geometry"/></mxCell>
        <mxCell id="ds-28" value="S4 30 s passed (worker)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-21" target="ds-27"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-29" value="&lt;b&gt;withdrawn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;no longer valid&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="ds-root1"><mxGeometry x="640" y="880" width="180" height="54" as="geometry"/></mxCell>
        <mxCell id="ds-30" value="order cancelled, picked up, or S8 reassign" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ds-root1" source="ds-21" target="ds-29"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ds-31" value="&lt;b&gt;Enforced by unique indexes&lt;/b&gt;&lt;br&gt;• one &lt;i&gt;pending&lt;/i&gt; offer per order&lt;br&gt;• one &lt;i&gt;pending&lt;/i&gt; offer per courier&lt;br&gt;• (order_id, round, courier_id) – nobody asked twice per round&lt;br&gt;• one active delivery per courier (on orders)&lt;br&gt;Lock order: user → order → offer.&lt;br&gt;Accept: lock the courier's users row (must be ACTIVE) → lock orders row → update offer WHERE pending AND expires_at &amp;gt; now() → update order WHERE courier_id IS NULL." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ds-root1"><mxGeometry x="880" y="640" width="360" height="200" as="geometry"/></mxCell>
