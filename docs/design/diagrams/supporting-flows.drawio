<mxfile host="drawio">
  <diagram id="al" name="Account lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="al-root0"/>
        <mxCell id="al-root1" parent="al-root0"/>
        <mxCell id="al-1" value="&lt;b&gt;PENDING_ACTIVATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;email not verified yet&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="al-root1"><mxGeometry x="140" y="260" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="al-2" value="&lt;b&gt;PENDING_APPROVAL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;owner / courier: waiting for admin&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="al-root1"><mxGeometry x="500" y="260" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="al-3" value="&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;full access for the role&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="al-root1"><mxGeometry x="860" y="260" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="al-4" value="&lt;b&gt;SUSPENDED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;cannot log in · sessions revoked&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="al-root1"><mxGeometry x="1220" y="260" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="al-5" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;can log in to see reason / reapply&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="al-root1"><mxGeometry x="500" y="480" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="al-6" value="&lt;b&gt;DELETED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PII anonymized · orders kept&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="al-root1"><mxGeometry x="860" y="640" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="al-7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="al-root1"><mxGeometry x="50" y="280.0" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="al-8" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="al-root1"><mxGeometry x="225.0" y="500" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="al-9" value="A1 sign up" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-7" target="al-1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-10" value="A3 owner / courier&lt;br&gt;opens email link" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-1" target="al-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-11" value="A2 customer opens email link" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-1" target="al-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240.0" y="190"/><mxPoint x="960.0" y="190"/></Array></mxGeometry></mxCell>
        <mxCell id="al-12" value="A5 admin approves" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-2" target="al-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-13" value="A8 admin suspends&lt;br&gt;(reason)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-3" target="al-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-14" value="A9 admin reactivates" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-4" target="al-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-15" value="A6 admin rejects&lt;br&gt;(reason)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-2" target="al-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-16" value="A7 reapply (max 3)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-5" target="al-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-17" value="A4 not activated in 7 days&lt;br&gt;sweeper hard-deletes" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-1" target="al-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-18" value="A10 user deletes&lt;br&gt;(password, no active orders)" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-3" target="al-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-19" value="A10 user deletes" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-5" target="al-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-20" value="A10 user withdraws" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-2" target="al-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="311.2"/><mxPoint x="440" y="652.8"/></Array></mxGeometry></mxCell>
        <mxCell id="al-21" value="A11 admin deletes" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="al-root1" source="al-4" target="al-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="al-22" value="BiteFetch – Account lifecycle (users.status)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="al-root1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="al-23" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;• Customers skip PENDING_APPROVAL (A2). Owners and couriers need an approved application (A3 → A5).&lt;br&gt;• The admin is seeded with status ACTIVE – there is no admin signup.&lt;br&gt;• Every arrow = UPDATE users … WHERE status = &amp;lt;from&amp;gt; in one transaction; a trigger writes account_status_history.&lt;br&gt;• Leaving ACTIVE (A8, A10, A11) revokes refresh tokens and disconnects sockets on every instance.&lt;br&gt;• Access tokens live up to 15 min, so state-changing endpoints re-check users.status in their own transaction.&lt;br&gt;• Thick border = terminal." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="al-root1"><mxGeometry x="1180" y="730" width="420" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sa" name="Signup → approval">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="1978" math="0" shadow="0">
      <root>
        <mxCell id="sa-root0"/>
        <mxCell id="sa-root1" parent="sa-root0"/>
        <mxCell id="sa-lane-U" value="User (customer, owner or courier)" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="80" width="330" height="1858" as="geometry"/></mxCell>
        <mxCell id="sa-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="sa-root1"><mxGeometry x="370" y="80" width="300" height="1858" as="geometry"/></mxCell>
        <mxCell id="sa-lane-S" value="System (API · workers · DB) + Email provider" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="sa-root1"><mxGeometry x="670" y="80" width="400" height="1858" as="geometry"/></mxCell>
        <mxCell id="sa-1" value="Fill the signup form&lt;br&gt;owner: restaurant details · courier: vehicle + contact" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="94.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-2" value="&lt;b&gt;A1&lt;/b&gt; INSERT user PENDING_ACTIVATION (unique email)&lt;br&gt;owner/courier: INSERT application (pending)&lt;br&gt;token hash + outbox email.activation · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="94.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-3" value="“Check your email”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="162.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-4" value="&lt;i&gt;Email provider (external)&lt;/i&gt;&lt;br&gt;Activation email with a one-time link (24 h)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="274.0" width="360" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-5" value="Open the link" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="378.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-6" value="UPDATE email_tokens SET used_at = now()&lt;br&gt;WHERE token_hash = $1 AND used_at IS NULL&lt;br&gt;AND expires_at &amp;gt; now() → single use" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="378.0" width="360" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-7" value="customer: &lt;b&gt;A2&lt;/b&gt; → ACTIVE · owner/courier: &lt;b&gt;A3&lt;/b&gt; → PENDING_APPROVAL&lt;br&gt;UPDATE users … WHERE status = PENDING_ACTIVATION · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="446.0" width="360" height="188.0" as="geometry"/></mxCell>
        <mxCell id="sa-8" value="Customer: signed in&lt;br&gt;Owner/courier: “Application under review”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="514.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-9" value="New application in queue" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="sa-lane-A"><mxGeometry x="12" y="582.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-10" value="Link expired → “Resend link”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="650.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-11" value="New token, older ones invalidated&lt;br&gt;rate-limited per email and IP" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="650.0" width="360" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-12" value="Review, approve" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="sa-lane-A"><mxGeometry x="12" y="754.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-13" value="&lt;b&gt;A5&lt;/b&gt; application → approved WHERE pending AND version&lt;br&gt;user → ACTIVE WHERE PENDING_APPROVAL&lt;br&gt;owner: link existing or create restaurant · courier: profile" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="754.0" width="360" height="188.0" as="geometry"/></mxCell>
        <mxCell id="sa-14" value="Queue updated" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="sa-lane-A"><mxGeometry x="12" y="822.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-15" value="“Approved – you can start”&lt;br&gt;(+ email)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="890.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-16" value="…or reject with a reason" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="sa-lane-A"><mxGeometry x="12" y="958.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-17" value="&lt;b&gt;A6&lt;/b&gt; application → rejected · user → REJECTED · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="958.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-18" value="Sees the reason (+ email)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1026.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-19" value="Edit details, reapply (max 3)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1094.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-20" value="&lt;b&gt;A7&lt;/b&gt; INSERT new application (one pending per user)&lt;br&gt;user → PENDING_APPROVAL WHERE REJECTED" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="1094.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-21" value="Back in the queue" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="sa-lane-A"><mxGeometry x="12" y="1162.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-22" value="Enter email" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1266.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-23" value="If the account exists: token (1 h) + outbox email" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="1266.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-24" value="“If the account exists, we sent a link”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1334.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-25" value="Open link, choose new password" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1402.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-26" value="Consume token (single use) · new password hash&lt;br&gt;token_version + 1 · revoke all refresh tokens" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="1402.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-27" value="Log in again on every device" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1470.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-28" value="Suspend (reason)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="sa-lane-A"><mxGeometry x="12" y="1574.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-29" value="&lt;b&gt;A8&lt;/b&gt; → SUSPENDED WHERE ACTIVE AND version&lt;br&gt;revoke refresh tokens · courier forced offline&lt;br&gt;refused (409) while the courier has an active delivery" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="1574.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-30" value="Signed out on every device" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1642.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-31" value="Delete account&lt;br&gt;(re-enter password)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1710.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-32" value="&lt;b&gt;A10&lt;/b&gt; guard: no non-terminal orders / deliveries&lt;br&gt;→ DELETED · anonymize PII · revoke tokens" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="sa-lane-S"><mxGeometry x="20" y="1710.0" width="360" height="120.0" as="geometry"/></mxCell>
        <mxCell id="sa-33" value="Signed out" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sa-lane-U"><mxGeometry x="30" y="1778.0" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="sa-ph0" value="1 · Sign up (customer, owner or courier – role comes from the route, never the body)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="134" width="1030" height="28" as="geometry"/></mxCell>
        <mxCell id="sa-ph1" value="2 · Activate (the link opens an app page that POSTs the token – mail scanners only do GET)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="418" width="1030" height="28" as="geometry"/></mxCell>
        <mxCell id="sa-ph2" value="3 · Admin review (owner and courier only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="794" width="1030" height="28" as="geometry"/></mxCell>
        <mxCell id="sa-ph3" value="4 · Forgot password (no change of account status)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="1306" width="1030" height="28" as="geometry"/></mxCell>
        <mxCell id="sa-ph4" value="5 · Later: suspend and delete" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="1614" width="1030" height="28" as="geometry"/></mxCell>
        <mxCell id="sa-e0" value="N1 · POST /api/auth/signup&lt;br&gt;(/owner, /courier)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-1" target="sa-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e1" value="N2 · 202 – same reply if the email exists" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-2" target="sa-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e2" value="N3 · outbox worker → send email" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-2" target="sa-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e3" value="N4 · POST /api/auth/activate {token}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-5" target="sa-6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e4" value="N5 · 200 {status} + tokens" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-7" target="sa-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e5" value="N6 · ⚡&lt;br&gt;application.new" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-7" target="sa-9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e6" value="N7 · POST /api/auth/activation/resend" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-10" target="sa-11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e7" value="N8 · POST …/admin/&lt;br&gt;applications/:id/approve" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1383;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-12" target="sa-13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e8" value="N9 · 200" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-13" target="sa-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e9" value="N10 · ⚡ account.updated · ACTIVE" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-13" target="sa-15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e10" value="N11 · POST …/admin/&lt;br&gt;applications/:id/reject" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-16" target="sa-17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e11" value="N12 · ⚡ account.updated · REJECTED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-17" target="sa-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e12" value="N13 · POST /api/me/application" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-19" target="sa-20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e13" value="N14 · ⚡&lt;br&gt;application.new" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-20" target="sa-21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e14" value="N15 · POST /api/auth/password/forgot" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-22" target="sa-23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e15" value="N16 · 202 always" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-23" target="sa-24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e16" value="N17 · POST /api/auth/password/reset" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-25" target="sa-26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e17" value="N18 · 204" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-26" target="sa-27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e18" value="N19 · POST …/admin/&lt;br&gt;users/:id/suspend" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-28" target="sa-29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e19" value="N20 · ⚡ account.updated · SUSPENDED&lt;br&gt;then disconnectSockets(user:{id})" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-29" target="sa-30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e20" value="N21 · DELETE /api/me" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-31" target="sa-32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e21" value="N22 · 204 (409 if an order is still active)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sa-root1" source="sa-32" target="sa-33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-title" value="Signup, activation and approval – plus later account events" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="sa-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="sa-note0" value="&lt;b&gt;Status changes (users.status)&lt;/b&gt;&lt;br&gt;A1 → PENDING_ACTIVATION&lt;br&gt;A2 customer → ACTIVE · A3 owner/courier → PENDING_APPROVAL&lt;br&gt;A5 → ACTIVE · A6 → REJECTED · A7 → PENDING_APPROVAL&lt;br&gt;A8 → SUSPENDED · A9 → ACTIVE · A10/A11 → DELETED&lt;br&gt;applications: pending → approved | rejected (new row per reapply)&lt;br&gt;email_tokens: used_at set exactly once" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sa-root1"><mxGeometry x="1110" y="80" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="sa-note1" value="&lt;b&gt;Races – one wins&lt;/b&gt;&lt;br&gt;• Double click on the activation link: token UPDATE … WHERE used_at IS NULL → second gets 0 rows → reply with current status.&lt;br&gt;• Two signups, same email: unique index on lower(email) → one row; the other gets the same 202.&lt;br&gt;• Two admins approve/reject at once: WHERE status = 'pending' AND version = $seen → loser gets 409.&lt;br&gt;• Suspend vs courier accepting an offer: same transaction locks the user row; offer accept checks status = ACTIVE.&lt;br&gt;• Delete vs placing an order: both lock the user row; order insert checks status = ACTIVE." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sa-root1"><mxGeometry x="1110" y="250" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="sa-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 email already exists: honest error · &lt;b&gt;same 202 + “you already have an account” email&lt;/b&gt; · silent 202&lt;br&gt;Q2 reapply: never · &lt;b&gt;edit + resubmit, one pending, max 3&lt;/b&gt; · after 7-day cooldown&lt;br&gt;Q3 approved owner: create restaurant · link existing · &lt;b&gt;link if it exists, else create&lt;/b&gt;&lt;br&gt;Q4 sessions: long JWT · &lt;b&gt;15-min JWT + rotating refresh tokens in DB&lt;/b&gt; · DB/Redis session per request&lt;br&gt;Q5 delete: hard delete · &lt;b&gt;soft delete + anonymize, keep orders&lt;/b&gt; · deactivate only&lt;br&gt;Q6 never activated: keep · &lt;b&gt;purge after 7 days&lt;/b&gt; · purge after 30 days&lt;br&gt;Q7 suspend courier mid-delivery: &lt;b&gt;refuse until reassigned/delivered&lt;/b&gt; · suspend + auto-reassign" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sa-root1"><mxGeometry x="1110" y="470" width="380" height="230" as="geometry"/></mxCell>
        <mxCell id="sa-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;A-numbers = account transitions (page “Account lifecycle”)&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sa-root1"><mxGeometry x="1110" y="720" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ch" name="Chat">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1810" pageHeight="1902" math="0" shadow="0">
      <root>
        <mxCell id="ch-root0"/>
        <mxCell id="ch-root1" parent="ch-root0"/>
        <mxCell id="ch-lane-C" value="Customer" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="80" width="290" height="1782" as="geometry"/></mxCell>
        <mxCell id="ch-lane-R" value="Restaurant owner" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f6fbf5;" vertex="1" parent="ch-root1"><mxGeometry x="330" y="80" width="290" height="1782" as="geometry"/></mxCell>
        <mxCell id="ch-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="ch-root1"><mxGeometry x="620" y="80" width="320" height="1782" as="geometry"/></mxCell>
        <mxCell id="ch-lane-S" value="System (API · workers · DB) + Stripe" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="ch-root1"><mxGeometry x="940" y="80" width="410" height="1782" as="geometry"/></mxCell>
        <mxCell id="ch-1" value="Tap “Chat with restaurant”&lt;br&gt;on the order" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="94.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-2" value="&lt;b&gt;C1&lt;/b&gt; INSERT conversation (type order)&lt;br&gt;ON CONFLICT (order_id) DO NOTHING → return the existing one&lt;br&gt;guard: customer owns the order · 24 h window" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="94.0" width="370" height="120.0" as="geometry"/></mxCell>
        <mxCell id="ch-3" value="Chat screen opens" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="162.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-4" value="Join the room" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="230.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-5" value="Authorize: is this user a participant?&lt;br&gt;then socket.join(conversation:{id})" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="230.0" width="370" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-6" value="Type, send&lt;br&gt;(clientMsgId = new uuid)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="334.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-7" value="&lt;b&gt;C2&lt;/b&gt; UPDATE conversations SET last_seq = last_seq + 1 RETURNING&lt;br&gt;INSERT message ON CONFLICT (conversation_id, client_msg_id)&lt;br&gt;DO NOTHING · customer writes on RESOLVED → OPEN (&lt;b&gt;C4&lt;/b&gt;) · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="334.0" width="370" height="188.0" as="geometry"/></mxCell>
        <mxCell id="ch-8" value="Message shown as sent (seq 7)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="402.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-9" value="Inbox: unread badge,&lt;br&gt;thread moves to the top" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="470.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-10" value="Open the thread" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="574.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-11" value="Authorize: order belongs to the owner's restaurant&lt;br&gt;return messages page by seq" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="574.0" width="370" height="120.0" as="geometry"/></mxCell>
        <mxCell id="ch-12" value="History shown" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="642.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-13" value="Thread visible → mark read" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="710.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-14" value="UPSERT conversation_reads&lt;br&gt;last_read_seq = GREATEST(old, $seq)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="710.0" width="370" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-15" value="Reply" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="778.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-16" value="&lt;b&gt;C2&lt;/b&gt; same insert path → seq 8" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="778.0" width="370" height="120.0" as="geometry"/></mxCell>
        <mxCell id="ch-17" value="Reply appears in the chat" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="846.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-18" value="Staff reply still unread after 10 min → email the customer&lt;br&gt;(sweeper, at most 1 per conversation per hour)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="914.0" width="370" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-19" value="Mark as resolved" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="1018.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-20" value="&lt;b&gt;C3&lt;/b&gt; UPDATE conversations SET status = RESOLVED&lt;br&gt;WHERE status = OPEN AND last_seq = $seenSeq" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="1018.0" width="370" height="188.0" as="geometry"/></mxCell>
        <mxCell id="ch-21" value="Thread moves to “Resolved”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="ch-lane-R"><mxGeometry x="30" y="1086.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-22" value="“Marked resolved” line in the chat" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="1154.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-23" value="“Contact support”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="1258.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-24" value="&lt;b&gt;C1&lt;/b&gt; INSERT support conversation&lt;br&gt;one OPEN support chat per customer (unique partial index)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="1258.0" width="370" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-25" value="Send message" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="1326.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-26" value="&lt;b&gt;C2&lt;/b&gt; insert as in step 2" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="1326.0" width="370" height="120.0" as="geometry"/></mxCell>
        <mxCell id="ch-27" value="Support inbox: new thread" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ch-lane-A"><mxGeometry x="12" y="1394.0" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-28" value="Reply, then resolve" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ch-lane-A"><mxGeometry x="12" y="1462.0" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-29" value="&lt;b&gt;C2&lt;/b&gt; insert · &lt;b&gt;C3&lt;/b&gt; resolve with seenSeq" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="1462.0" width="370" height="120.0" as="geometry"/></mxCell>
        <mxCell id="ch-30" value="Reply + “resolved” line" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="1530.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-31" value="Reconnect: send last seq&lt;br&gt;for each open conversation" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ch-lane-C"><mxGeometry x="30" y="1634.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-32" value="Return messages with seq &amp;gt; client's last seq&lt;br&gt;client also refetches when it sees a seq gap" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="1634.0" width="370" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-33" value="Sweeper: &lt;b&gt;C5&lt;/b&gt; order chat → CLOSED (read-only) 24 h after the order ends&lt;br&gt;support chat → CLOSED 7 days after it was resolved" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ch-lane-S"><mxGeometry x="20" y="1702.0" width="370" height="52" as="geometry"/></mxCell>
        <mxCell id="ch-ph0" value="1 · Start an order chat (order active, or ended less than 24 h ago)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="134" width="1310" height="28" as="geometry"/></mxCell>
        <mxCell id="ch-ph1" value="2 · Customer sends a message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="374" width="1310" height="28" as="geometry"/></mxCell>
        <mxCell id="ch-ph2" value="3 · Owner reads and replies" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="614" width="1310" height="28" as="geometry"/></mxCell>
        <mxCell id="ch-ph3" value="4 · Owner marks the chat resolved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="1058" width="1310" height="28" as="geometry"/></mxCell>
        <mxCell id="ch-ph4" value="5 · Support chat (customer ↔ admin) – same mechanics, different room" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="1298" width="1310" height="28" as="geometry"/></mxCell>
        <mxCell id="ch-ph5" value="6 · Reconnect or missed event (another instance, network drop)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="1674" width="1310" height="28" as="geometry"/></mxCell>
        <mxCell id="ch-e0" value="H1 · POST /api/orders/:id/conversation" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-1" target="ch-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e1" value="H2 · 200 {conversationId, lastSeq}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-2" target="ch-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e2" value="H3 · ⚡ chat.join {conversationId}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-4" target="ch-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e3" value="H4 · POST /api/conversations/:id/messages&lt;br&gt;{clientMsgId, body}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1383;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-6" target="ch-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e4" value="H5 · 201 {message, seq}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-7" target="ch-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e5" value="H6 · ⚡ chat.message → restaurant:{id}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-7" target="ch-9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e6" value="H7 · GET /api/conversations/:id/messages" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-10" target="ch-11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e7" value="H8 · 200 [messages]" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-11" target="ch-12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e8" value="H9 · POST /api/conversations/:id/read {seq}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-13" target="ch-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e9" value="H10 · POST /api/conversations/:id/messages" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-15" target="ch-16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e10" value="H11 · ⚡ chat.message → conversation:{id}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-16" target="ch-17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e11" value="H12 · POST /api/conversations/:id/resolve {seenSeq}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1383;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-19" target="ch-20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e12" value="H13 · 200 – or 409 if a new message arrived" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-20" target="ch-21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e13" value="H14 · ⚡ chat.updated · RESOLVED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-20" target="ch-22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e14" value="H15 · POST /api/support/conversations" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-23" target="ch-24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e15" value="H16 · POST /api/conversations/:id/messages" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-25" target="ch-26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e16" value="H17 · ⚡&lt;br&gt;chat.message → admin" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-26" target="ch-27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e17" value="H18 · POST …/messages&lt;br&gt;then …/resolve" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-28" target="ch-29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e18" value="H19 · ⚡ chat.message, chat.updated" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-29" target="ch-30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-e19" value="H20 · GET /api/conversations/:id/messages?afterSeq=7" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ch-root1" source="ch-31" target="ch-32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ch-title" value="Chat – order chat (customer ↔ restaurant) and support chat (customer ↔ admin)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="ch-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="ch-note0" value="&lt;b&gt;Conversation status&lt;/b&gt;&lt;br&gt;C1 ∅ → OPEN (customer starts)&lt;br&gt;C2 new message: seq + 1, status unchanged&lt;br&gt;C3 OPEN → RESOLVED (owner or admin, seenSeq must match)&lt;br&gt;C4 RESOLVED → OPEN (customer writes again)&lt;br&gt;C5 OPEN/RESOLVED → CLOSED (sweeper, read-only)&lt;br&gt;Who: customer ↔ restaurant (order chat), customer ↔ admin (support). Couriers have no chat." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ch-root1"><mxGeometry x="1390" y="80" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="ch-note1" value="&lt;b&gt;Races – one wins, nothing duplicated&lt;/b&gt;&lt;br&gt;• Two messages at once: the conversation row lock serializes last_seq + 1 → gap-free seq per conversation.&lt;br&gt;• Retry / double send: UNIQUE (conversation_id, client_msg_id) → same message returned, no duplicate.&lt;br&gt;• Two tabs start the same order chat: UNIQUE (order_id) → both get the same conversation.&lt;br&gt;• Resolve vs new customer message: resolve needs last_seq = seenSeq → 409 “new message arrived”.&lt;br&gt;• Late read receipt: GREATEST() so unread counts never go back up.&lt;br&gt;• Recipient on another instance: socket.io Redis adapter; gaps healed by afterSeq fetch." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ch-root1"><mxGeometry x="1390" y="260" width="380" height="220" as="geometry"/></mxCell>
        <mxCell id="ch-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 order chat window: while active only · &lt;b&gt;active + 24 h after it ends, then read-only&lt;/b&gt; · any time&lt;br&gt;Q2 customer writes after resolved: &lt;b&gt;reopen same thread&lt;/b&gt; · new thread · blocked&lt;br&gt;Q3 sending: socket emit + ack · &lt;b&gt;HTTP POST + socket fan-out&lt;/b&gt; · both&lt;br&gt;Q4 offline recipient: badge only · &lt;b&gt;email if unread 10 min&lt;/b&gt; · web push&lt;br&gt;Q5 admin and order chats: never · &lt;b&gt;read-only, audited&lt;/b&gt; · can post&lt;br&gt;Q6 content: &lt;b&gt;text only (≤ 2000 chars)&lt;/b&gt; · + images · + order item references&lt;br&gt;Q7 event delivery: outbox · &lt;b&gt;emit after commit + seq gap fill&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ch-root1"><mxGeometry x="1390" y="500" width="380" height="220" as="geometry"/></mxCell>
        <mxCell id="ch-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;C-numbers = conversation transitions · H-numbers = chat messages&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ch-root1"><mxGeometry x="1390" y="740" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
