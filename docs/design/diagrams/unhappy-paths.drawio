        <mxCell id="u1-17" value="&lt;i&gt;Stripe (external)&lt;/i&gt;&lt;br&gt;PaymentIntent canceled · hold released&lt;br&gt;worker sets payment_status = voided" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="u1-lane-S"><mxGeometry x="20" y="1204.0" width="330" height="52" as="geometry"/></mxCell>
