        <mxCell id="u1-9" value="2nd consecutive timeout → pause restaurant's incoming orders + admin incident" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u1-lane-S"><mxGeometry x="20" y="642.0" width="330" height="52" as="geometry"/></mxCell>
        <mxCell id="u1-10" value="Late tap on Accept" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u1-lane-R"><mxGeometry x="30" y="710.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u1-11" value="Accept guard AND accept_deadline &amp;gt; now()&lt;br&gt;→ 0 rows updated" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u1-lane-S"><mxGeometry x="20" y="710.0" width="330" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u1-12" value="“Too late – order was auto-rejected”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u1-lane-R"><mxGeometry x="30" y="778.0" width="230" height="52" as="geometry"/></mxCell>
