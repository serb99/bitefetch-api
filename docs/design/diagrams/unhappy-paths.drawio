        <mxCell id="u5-lane-C" value="Customer" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="80" width="290" height="1356" as="geometry"/></mxCell>
