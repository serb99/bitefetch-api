        <mxCell id="u2-lane-K1" value="Courier 1 (declines)" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf6fc;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="80" width="300" height="1066" as="geometry"/></mxCell>
        <mxCell id="u2-lane-K2" value="Courier 2 (next nearest)" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf6fc;" vertex="1" parent="u2-root1"><mxGeometry x="340" y="80" width="300" height="1066" as="geometry"/></mxCell>
        <mxCell id="u2-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="u2-root1"><mxGeometry x="640" y="80" width="300" height="1066" as="geometry"/></mxCell>
        <mxCell id="u2-lane-S" value="System (API · workers · DB) + Stripe" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="u2-root1"><mxGeometry x="940" y="80" width="420" height="1066" as="geometry"/></mxCell>
        <mxCell id="u2-1" value="&lt;b&gt;S2&lt;/b&gt; dispatch worker: nearest online idle courier&lt;br&gt;INSERT order_offers (Courier 1, round 1, pending, expires_at = now + 30 s)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u2-lane-S"><mxGeometry x="20" y="94.0" width="380" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u2-2" value="Offer card: restaurant, address, distance&lt;br&gt;app timer 25 s (server allows 30 s)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K1"><mxGeometry x="30" y="162.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-3" value="Tap Decline&lt;br&gt;optional reason: too far · busy · vehicle · other" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K1"><mxGeometry x="30" y="266.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-4" value="&lt;b&gt;S3&lt;/b&gt; lock the order row first, then UPDATE order_offers&lt;br&gt;SET status = declined, responded_at, decline_reason&lt;br&gt;WHERE id AND courier_id = me AND status = pending · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u2-lane-S"><mxGeometry x="20" y="266.0" width="380" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u2-5" value="Card removed · stays online and idle" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K1"><mxGeometry x="30" y="334.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-6" value="Tap Decline too late" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K1"><mxGeometry x="30" y="438.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-7" value="0 rows updated → re-read the offer&lt;br&gt;declined by me already → 200 (idempotent)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u2-lane-S"><mxGeometry x="20" y="438.0" width="380" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u2-8" value="Card removed, no error toast" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K1"><mxGeometry x="30" y="506.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-9" value="Dispatch for this order: lock order FOR UPDATE SKIP LOCKED&lt;br&gt;no pending offer? → nearest online idle courier not yet asked&lt;br&gt;in this round · radius 3 → 6 → 10 km" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u2-lane-S"><mxGeometry x="20" y="610.0" width="380" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-10" value="INSERT order_offers (Courier 2, round 1, pending, now + 30 s)&lt;br&gt;unique indexes: one pending per order and per courier · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u2-lane-S"><mxGeometry x="20" y="678.0" width="380" height="188.0" as="geometry"/></mxCell>
        <mxCell id="u2-11" value="Offer card · app timer 25 s&lt;br&gt;(server allows 30 s)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K2"><mxGeometry x="30" y="746.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-12" value="Dispatch view: C1 declined,&lt;br&gt;C2 offered" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u2-lane-A"><mxGeometry x="12" y="814.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-13" value="Accept → happy path S5 (M14) · Decline → this flow again&lt;br&gt;No answer in 30 s → flow 3 (offer times out)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u2-lane-K2"><mxGeometry x="30" y="918.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-14" value="No eligible courier left within 10 km → keep searching for newly online couriers&lt;br&gt;until dispatch_deadline → flow 4 (nobody accepts)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u2-lane-S"><mxGeometry x="20" y="986.0" width="380" height="52" as="geometry"/></mxCell>
        <mxCell id="u2-ph0" value="Start: order ACCEPTED or READY_FOR_PICKUP · dispatch_state = searching · offer to Courier 1 pending (30 s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="134" width="1320" height="28" as="geometry"/></mxCell>
        <mxCell id="u2-ph1" value="1 · Courier 1 declines (S3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="306" width="1320" height="28" as="geometry"/></mxCell>
        <mxCell id="u2-ph2" value="1b · …the same tap when the offer is no longer pending (expired, withdrawn or answered)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="478" width="1320" height="28" as="geometry"/></mxCell>
        <mxCell id="u2-ph3" value="2 · Next courier offered right away (kick after commit; the 2 s worker poll is the fallback)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="650" width="1320" height="28" as="geometry"/></mxCell>
        <mxCell id="u2-ph4" value="3 · What happens next" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="958" width="1320" height="28" as="geometry"/></mxCell>
        <mxCell id="u2-e0" value="M13 · ⚡ offer.created → courier:{id}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-1" target="u2-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-e1" value="D1 · POST /api/courier/offers/:offerId/decline&lt;br&gt;{reason}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-3" target="u2-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-e2" value="D2 · 200 {offerStatus: declined}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-4" target="u2-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-e3" value="D1 · same request" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-6" target="u2-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-e4" value="D3 · 409 {offerStatus: expired | withdrawn | accepted}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;endArrow=open;endFill=0;fontColor=#b85450;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-7" target="u2-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-e5" value="D4 · ⚡ offer.created → courier:{id}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-10" target="u2-11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-e6" value="D5 · ⚡&lt;br&gt;dispatch.updated" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u2-root1" source="u2-10" target="u2-12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u2-title" value="Unhappy path 2 – Courier declines an offer (S3, then S2 again)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="u2-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u2-note0" value="&lt;b&gt;What changes&lt;/b&gt;&lt;br&gt;orders.status: unchanged (ACCEPTED or READY_FOR_PICKUP)&lt;br&gt;orders.dispatch_state: stays searching&lt;br&gt;order_offers: Courier 1 pending → declined (+ reason, responded_at)&lt;br&gt;order_offers: new row Courier 2 pending, same round&lt;br&gt;Customer and restaurant: no event – still “finding a courier”&lt;br&gt;Payment: none" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u2-root1"><mxGeometry x="1400" y="80" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="u2-note1" value="&lt;b&gt;Races – one wins&lt;/b&gt;&lt;br&gt;• Decline vs 30 s expiry sweep: both WHERE status = pending → one outcome.&lt;br&gt;• Decline vs order cancelled (offer withdrawn): decline gets 409, card removed.&lt;br&gt;• Decline vs accept from the same courier on two devices: one wins.&lt;br&gt;• Kick vs worker tick for the same order: FOR UPDATE SKIP LOCKED + one-pending-per-order index → one new offer.&lt;br&gt;• Two orders pick the same next courier: one-pending-per-courier index → the loser takes the next courier.&lt;br&gt;• Instance dies after COMMIT, before the kick: the worker poll offers the next courier within 2 s." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u2-root1"><mxGeometry x="1400" y="250" width="380" height="220" as="geometry"/></mxCell>
        <mxCell id="u2-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 next offer: wait for worker poll · &lt;b&gt;kick after commit + poll fallback&lt;/b&gt; · LISTEN/NOTIFY dispatcher&lt;br&gt;Q2 decline reason: none · &lt;b&gt;optional reason code&lt;/b&gt; · required&lt;br&gt;Q3 frequent decliners: &lt;b&gt;no penalty, metric for admin&lt;/b&gt; · “still available?” after 5 · lower ranking&lt;br&gt;Q4 customer sees: &lt;b&gt;“finding a courier” only&lt;/b&gt; · “asking courier 2” · count of declines" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u2-root1"><mxGeometry x="1400" y="490" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="u2-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;S-numbers = dispatch transitions in docs/design/notes/order-state-machine.md&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u2-root1"><mxGeometry x="1400" y="660" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="u3" name="3 · Offer times out">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1254" math="0" shadow="0">
      <root>
        <mxCell id="u3-root0"/>
        <mxCell id="u3-root1" parent="u3-root0"/>
        <mxCell id="u3-lane-K1" value="Courier 1 (declines)" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf6fc;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="80" width="310" height="1134" as="geometry"/></mxCell>
        <mxCell id="u3-lane-K2" value="Courier 2 (next nearest)" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf6fc;" vertex="1" parent="u3-root1"><mxGeometry x="350" y="80" width="290" height="1134" as="geometry"/></mxCell>
        <mxCell id="u3-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="u3-root1"><mxGeometry x="640" y="80" width="300" height="1134" as="geometry"/></mxCell>
        <mxCell id="u3-lane-S" value="System (API · workers · DB) + Stripe" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="u3-root1"><mxGeometry x="940" y="80" width="440" height="1134" as="geometry"/></mxCell>
        <mxCell id="u3-1" value="&lt;b&gt;S2&lt;/b&gt; offer to Courier 1: pending, expires_at = offered_at + 30 s&lt;br&gt;candidates only if their last position is &amp;lt; 30 s old" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u3-lane-S"><mxGeometry x="20" y="94.0" width="400" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u3-2" value="Offer card · app timer shows 25 s" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K1"><mxGeometry x="30" y="162.0" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-3" value="No answer: app in background,&lt;br&gt;no signal, or ignored" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K1"><mxGeometry x="30" y="230.0" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-4" value="&lt;b&gt;S4&lt;/b&gt; UPDATE order_offers SET status = expired, responded_at = now()&lt;br&gt;WHERE id IN (… status = pending AND expires_at &amp;lt;= now()&lt;br&gt;ORDER BY expires_at LIMIT 100 FOR UPDATE SKIP LOCKED) RETURNING · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u3-lane-S"><mxGeometry x="20" y="334.0" width="400" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u3-5" value="Card removed: “Offer expired”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K1"><mxGeometry x="30" y="402.0" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-6" value="Courier 1 missed 2 offers in a row&lt;br&gt;→ courier availability = offline (reason missed_offers)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u3-lane-S"><mxGeometry x="20" y="470.0" width="400" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u3-7" value="“You were set offline. Go online when you're ready.”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K1"><mxGeometry x="30" y="538.0" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-8" value="For every order returned above: dispatchOrder(orderId)&lt;br&gt;in its own transaction: lock order FOR UPDATE SKIP LOCKED&lt;br&gt;→ nearest fresh, idle courier not asked this round → INSERT offer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u3-lane-S"><mxGeometry x="20" y="642.0" width="400" height="188.0" as="geometry"/></mxCell>
        <mxCell id="u3-9" value="Offer card · 25 s timer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K2"><mxGeometry x="30" y="710.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-10" value="Dispatch view: C1 expired,&lt;br&gt;C2 offered" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u3-lane-A"><mxGeometry x="12" y="778.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-11" value="Taps Accept after the deadline" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K1"><mxGeometry x="30" y="882.0" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-12" value="&lt;b&gt;S5&lt;/b&gt; lock order row, UPDATE offer WHERE status = pending&lt;br&gt;AND expires_at &amp;gt; now() → 0 rows · ROLLBACK" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u3-lane-S"><mxGeometry x="20" y="882.0" width="400" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u3-13" value="“This offer has expired”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u3-lane-K1"><mxGeometry x="30" y="950.0" width="250" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-14" value="First sweep after restart expires every overdue offer in batches of 100&lt;br&gt;dispatch continues for each order · orders past dispatch_deadline → flow 4" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u3-lane-S"><mxGeometry x="20" y="1054.0" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="u3-ph0" value="Start: order ACCEPTED or READY_FOR_PICKUP · dispatch_state = searching" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="134" width="1340" height="28" as="geometry"/></mxCell>
        <mxCell id="u3-ph1" value="1 · Deadline passes – sweeper on any instance (S4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="374" width="1340" height="28" as="geometry"/></mxCell>
        <mxCell id="u3-ph2" value="2 · Next courier – same path as flow 2, step 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="682" width="1340" height="28" as="geometry"/></mxCell>
        <mxCell id="u3-ph3" value="3 · Late accept from Courier 1 (stale card or slow network)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="922" width="1340" height="28" as="geometry"/></mxCell>
        <mxCell id="u3-ph4" value="4 · After an outage (all instances were down)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="1094" width="1340" height="28" as="geometry"/></mxCell>
        <mxCell id="u3-e0" value="M13 · ⚡ offer.created → courier:{id}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-1" target="u3-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-e1" value="X1 · ⚡ offer.closed&lt;br&gt;{offerId, reason: expired}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-4" target="u3-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-e2" value="X2 · ⚡ courier.availability {online: false}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-6" target="u3-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-e3" value="X3 · ⚡ offer.created → courier:{id}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-8" target="u3-9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-e4" value="X4 · ⚡&lt;br&gt;dispatch.updated" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-8" target="u3-10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-e5" value="X5 · POST /api/courier/offers/:offerId/accept" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-11" target="u3-12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-e6" value="X6 · 409 {offerStatus: expired}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;endArrow=open;endFill=0;fontColor=#b85450;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u3-root1" source="u3-12" target="u3-13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u3-title" value="Unhappy path 3 – Offer times out (S4, then S2 again)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="u3-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u3-note0" value="&lt;b&gt;What changes&lt;/b&gt;&lt;br&gt;orders.status and dispatch_state: unchanged (searching)&lt;br&gt;order_offers: Courier 1 pending → expired (responded_at = sweep time)&lt;br&gt;order_offers: new row Courier 2 pending, same round&lt;br&gt;couriers: Courier 1 → offline after 2 misses in a row&lt;br&gt;Customer and restaurant: no event · Payment: none" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u3-root1"><mxGeometry x="1420" y="80" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="u3-note1" value="&lt;b&gt;Races and durability&lt;/b&gt;&lt;br&gt;• Accept vs expiry: accept needs expires_at &amp;gt; now(), sweep needs &amp;lt;= now(), both need pending → exactly one.&lt;br&gt;• Decline vs expiry: both WHERE status = pending → one outcome.&lt;br&gt;• Two sweepers: FOR UPDATE SKIP LOCKED → each offer expired once.&lt;br&gt;• No deadlock: the expiry transaction locks only offers; dispatch then locks the order in a new transaction.&lt;br&gt;• Restart: the deadline lives in expires_at, not in a timer → nothing is lost.&lt;br&gt;• All times use the database clock, never an instance clock." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u3-root1"><mxGeometry x="1420" y="240" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="u3-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 tap at 29.9 s: server exact, app shows 30 s · &lt;b&gt;app shows 25 s, server allows 30 s&lt;/b&gt; · server adds 3 s grace&lt;br&gt;Q2 missed offers: no consequence · &lt;b&gt;offline after 2 misses in a row&lt;/b&gt; · “still there?” prompt after 3&lt;br&gt;Q3 who gets offers: any online courier · &lt;b&gt;only with a position &amp;lt; 30 s old&lt;/b&gt; · explicit heartbeat&lt;br&gt;Q4 timeout length: &lt;b&gt;fixed 30 s (admin setting later)&lt;/b&gt; · by distance · adaptive" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u3-root1"><mxGeometry x="1420" y="460" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="u3-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;S-numbers = dispatch transitions in docs/design/notes/order-state-machine.md&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u3-root1"><mxGeometry x="1420" y="630" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="u4" name="4 · Nobody accepts">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1594" math="0" shadow="0">
      <root>
        <mxCell id="u4-root0"/>
        <mxCell id="u4-root1" parent="u4-root0"/>
        <mxCell id="u4-lane-C" value="Customer" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="80" width="270" height="1474" as="geometry"/></mxCell>
        <mxCell id="u4-lane-R" value="Restaurant owner" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f6fbf5;" vertex="1" parent="u4-root1"><mxGeometry x="310" y="80" width="250" height="1474" as="geometry"/></mxCell>
        <mxCell id="u4-lane-K" value="Courier" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf6fc;" vertex="1" parent="u4-root1"><mxGeometry x="560" y="80" width="250" height="1474" as="geometry"/></mxCell>
        <mxCell id="u4-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="u4-root1"><mxGeometry x="810" y="80" width="320" height="1474" as="geometry"/></mxCell>
        <mxCell id="u4-lane-S" value="System (API · workers · DB) + Stripe" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="u4-root1"><mxGeometry x="1130" y="80" width="430" height="1474" as="geometry"/></mxCell>
        <mxCell id="u4-1" value="Flows 2 and 3 ran: every fresh courier within 10 km declined or timed out&lt;br&gt;dispatchOrder finds no candidate → no offer inserted&lt;br&gt;next_search_at = now + backoff (2 → 5 → 10 → 30 s)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="94.0" width="390" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-2" value="&lt;b&gt;S6&lt;/b&gt; UPDATE orders SET dispatch_state = no_courier, version + 1&lt;br&gt;WHERE dispatch_state = searching AND courier_id IS NULL&lt;br&gt;AND dispatch_deadline &amp;lt;= now() · incident no_courier (deduplicated) · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="198.0" width="390" height="256.0" as="geometry"/></mxCell>
        <mxCell id="u4-3" value="“Still looking for a courier”&lt;br&gt;with a Cancel button" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u4-lane-C"><mxGeometry x="30" y="266.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-4" value="“No courier yet –&lt;br&gt;keep the food ready”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u4-lane-R"><mxGeometry x="30" y="334.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-5" value="Incident: no courier" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u4-lane-A"><mxGeometry x="12" y="402.0" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-6" value="Goes online, or finishes&lt;br&gt;another delivery" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u4-lane-K"><mxGeometry x="30" y="506.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-7" value="Kick: dispatch the oldest waiting orders&lt;br&gt;within 10 km of this courier (not asked this round)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="506.0" width="390" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u4-8" value="Offer card · 25 s timer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u4-lane-K"><mxGeometry x="30" y="574.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-9" value="Accept" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u4-lane-K"><mxGeometry x="30" y="642.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-10" value="&lt;b&gt;S5&lt;/b&gt; lock order · offer accepted · courier_id set&lt;br&gt;dispatch_state no_courier → assigned · resolve incident · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="642.0" width="390" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u4-11" value="“Courier found” · map shows courier" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u4-lane-C"><mxGeometry x="30" y="710.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-12" value="Nobody left to ask and 5 min since the round started&lt;br&gt;→ one automatic new round (round + 1) that re-asks couriers who declined" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="778.0" width="390" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-13" value="Retry dispatch" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u4-lane-A"><mxGeometry x="12" y="882.0" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-14" value="&lt;b&gt;S7&lt;/b&gt; WHERE dispatch_state = no_courier AND version = $seen&lt;br&gt;round + 1 · dispatch_state = searching · new 15 min deadline" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="882.0" width="390" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u4-15" value="Back to searching" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u4-lane-A"><mxGeometry x="12" y="950.0" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-16" value="…or cancel with a reason" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u4-lane-A"><mxGeometry x="12" y="1018.0" width="220" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-17" value="&lt;b&gt;T15&lt;/b&gt; → CANCELLED WHERE version = $seen&lt;br&gt;withdraw pending offer · outbox payment.void · resolve incident" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="1018.0" width="390" height="188.0" as="geometry"/></mxCell>
        <mxCell id="u4-18" value="“Order cancelled – you have&lt;br&gt;not been charged”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u4-lane-C"><mxGeometry x="30" y="1086.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-19" value="Order cancelled" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u4-lane-R"><mxGeometry x="30" y="1154.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-20" value="Tap Cancel" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u4-lane-C"><mxGeometry x="30" y="1258.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-21" value="&lt;b&gt;T18&lt;/b&gt; → CANCELLED WHERE status IN (ACCEPTED, READY_FOR_PICKUP)&lt;br&gt;AND dispatch_state = no_courier AND courier_id IS NULL&lt;br&gt;withdraw pending offer · outbox payment.void · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u4-lane-S"><mxGeometry x="20" y="1258.0" width="390" height="188.0" as="geometry"/></mxCell>
        <mxCell id="u4-22" value="“Cancelled – not charged”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u4-lane-C"><mxGeometry x="30" y="1326.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-23" value="Order cancelled (no courier)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u4-lane-R"><mxGeometry x="30" y="1394.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u4-ph0" value="Start: order ACCEPTED or READY_FOR_PICKUP · dispatch_state = searching · round 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="134" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u4-ph1" value="1 · dispatch_deadline passes (15 min after dispatch started) – sweeper on any instance (S6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="238" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u4-ph2" value="2 · The search goes on – a courier becomes free" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="546" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u4-ph3" value="3 · Admin decides when nobody accepts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="922" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u4-ph4" value="4 · The customer cancels while no courier is found (T18)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="1298" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u4-e0" value="Y1 · ⚡ order.updated · dispatchState no_courier" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.3672;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-2" target="u4-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e1" value="Y2 · ⚡ order.updated · no_courier" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.6328;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-2" target="u4-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e2" value="Y3 · ⚡&lt;br&gt;incident.opened" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8984;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-2" target="u4-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e3" value="Y4 · POST /api/courier/availability {online: true}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-6" target="u4-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e4" value="Y5 · ⚡ offer.created" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-7" target="u4-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e5" value="Y6 · POST /api/courier/offers/:offerId/accept" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-9" target="u4-10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e6" value="Y7 · ⚡ order.updated · assigned" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-10" target="u4-11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e7" value="Y8 · POST&lt;br&gt;…/retry-dispatch" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-13" target="u4-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e8" value="Y9 · 200&lt;br&gt;or 409" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-14" target="u4-15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e9" value="Y10 · POST&lt;br&gt;…/cancel" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1383;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-16" target="u4-17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e10" value="Y11 · ⚡ order.updated · CANCELLED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-17" target="u4-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e11" value="Y12 · ⚡ order.updated · CANCELLED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-17" target="u4-19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e12" value="Y13 · POST /api/orders/:id/cancel" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1383;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-20" target="u4-21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e13" value="Y14 · 200 – or 409 if a courier just accepted" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-21" target="u4-22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-e14" value="Y15 · ⚡ order.updated · CANCELLED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u4-root1" source="u4-21" target="u4-23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u4-title" value="Unhappy path 4 – Nobody accepts (S6, then a courier appears, S7 or cancel)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="u4-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u4-note0" value="&lt;b&gt;What changes&lt;/b&gt;&lt;br&gt;orders.dispatch_state: searching → no_courier (S6) → assigned (S5) or searching again (S7)&lt;br&gt;orders.status: unchanged unless cancelled (→ CANCELLED, payment voided)&lt;br&gt;orders.dispatch_round: + 1 on retry (admin, or one automatic round)&lt;br&gt;order_offers: pending offer withdrawn on cancel; new rounds allow re-asking&lt;br&gt;order_incidents: no_courier opened once, resolved on assign or cancel" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u4-root1"><mxGeometry x="1600" y="80" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="u4-note1" value="&lt;b&gt;Races – one wins&lt;/b&gt;&lt;br&gt;• S6 vs late courier accept: both lock the order; accept only needs courier_id IS NULL, so it works in either state.&lt;br&gt;• Admin retry or cancel vs courier accept: version check → admin gets 409 and re-decides.&lt;br&gt;• Customer cancel (T18) vs courier accept: courier_id IS NULL guard → exactly one wins.&lt;br&gt;• Two admins: version check → one action.&lt;br&gt;• Two sweepers: SKIP LOCKED + conditional update + unique open incident → one transition, one incident.&lt;br&gt;• Restart: deadline and backoff live in columns, nothing in memory." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u4-root1"><mxGeometry x="1600" y="260" width="380" height="210" as="geometry"/></mxCell>
        <mxCell id="u4-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 customer stuck waiting: only admin cancels · &lt;b&gt;customer may cancel while no_courier (changes D3)&lt;/b&gt; · auto-cancel after 30 min&lt;br&gt;Q2 more rounds: admin only · &lt;b&gt;one automatic re-ask round after 5 min&lt;/b&gt; · unlimited automatic rounds&lt;br&gt;Q3 prevent it: always allow orders · &lt;b&gt;block checkout when no fresh courier within 10 km&lt;/b&gt; · allow with a warning&lt;br&gt;Q4 search cost: every order every tick · &lt;b&gt;backoff + kick when a courier becomes free&lt;/b&gt; · kick only" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u4-root1"><mxGeometry x="1600" y="490" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="u4-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;S- and T-numbers = docs/design/notes/order-state-machine.md&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u4-root1"><mxGeometry x="1600" y="680" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="u5" name="5 · Customer cancels">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1476" math="0" shadow="0">
      <root>
