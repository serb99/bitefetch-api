        <mxCell id="u1-6" value="Order leaves the incoming list" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u1-lane-R"><mxGeometry x="30" y="402.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u1-7" value="&lt;b&gt;T8&lt;/b&gt; sweeper on any instance: PLACED past accept_deadline&lt;br&gt;FOR UPDATE SKIP LOCKED · UPDATE → REJECTED&lt;br&gt;reason = restaurant_timeout · outbox rows · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u1-lane-S"><mxGeometry x="20" y="506.0" width="330" height="120.0" as="geometry"/></mxCell>
