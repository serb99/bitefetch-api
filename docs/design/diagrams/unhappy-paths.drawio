        <mxCell id="u1-19" value="Tap “Back to cart”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u1-lane-C"><mxGeometry x="30" y="1420.0" width="200" height="52" as="geometry"/></mxCell>
