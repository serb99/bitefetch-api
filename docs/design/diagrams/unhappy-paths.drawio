        <mxCell id="u1-ph0" value="Start: status PLACED · payment authorized (hold) · accept_deadline = placed_at + 5 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u1-root1"><mxGeometry x="40" y="134" width="1160" height="28" as="geometry"/></mxCell>
        <mxCell id="u1-ph1" value="A · Owner rejects (T7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u1-root1"><mxGeometry x="40" y="306" width="1160" height="28" as="geometry"/></mxCell>
        <mxCell id="u1-ph2" value="B · No answer before accept_deadline (T8)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u1-root1"><mxGeometry x="40" y="546" width="1160" height="28" as="geometry"/></mxCell>
        <mxCell id="u1-ph3" value="After commit (both triggers) · outbox worker on any instance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u1-root1"><mxGeometry x="40" y="922" width="1160" height="28" as="geometry"/></mxCell>
        <mxCell id="u1-ph4" value="Customer's next step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u1-root1"><mxGeometry x="40" y="1460" width="1160" height="28" as="geometry"/></mxCell>
        <mxCell id="u1-e0" value="M8 · ⚡ order.new" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-1" target="u1-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e1" value="U1 · POST /api/restaurant/orders/:id/reject&lt;br&gt;{reasonCode, note}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-4" target="u1-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e2" value="U2 · 200 {status: REJECTED, version}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-5" target="u1-6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e3" value="U3 · ⚡ order.updated&lt;br&gt;REJECTED (restaurant_timeout)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-7" target="u1-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e4" value="POST /api/restaurant/orders/:id/accept" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-10" target="u1-11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e5" value="409 {status: REJECTED}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;endArrow=open;endFill=0;fontColor=#b85450;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-11" target="u1-12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e6" value="U4 · ⚡ order.updated&lt;br&gt;REJECTED + reasonCode" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.3672;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-13" target="u1-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e7" value="U5 · ⚡ order.updated · REJECTED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.6328;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-13" target="u1-15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e8" value="U6 · ⚡&lt;br&gt;order.updated" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8984;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-13" target="u1-16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e9" value="U7 · paymentIntents.cancel&lt;br&gt;idempotency key order:{id}:void (retried with backoff)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-13" target="u1-17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e10" value="U8 · webhook payment_intent.canceled" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-17" target="u1-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e11" value="U9 · GET /api/cart" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-19" target="u1-20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-e12" value="U10 · 200 {cart}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u1-root1" source="u1-20" target="u1-21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u1-title" value="Unhappy path 1 – Restaurant rejects the order (T7 / T8)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="u1-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u1-note0" value="&lt;b&gt;Status changes&lt;/b&gt;&lt;br&gt;PLACED → REJECTED (terminal)&lt;br&gt;cancelled_by = restaurant | system&lt;br&gt;cancel_reason = reason code | restaurant_timeout&lt;br&gt;payment_status authorized → voided (after Stripe confirms)&lt;br&gt;order_status_history: 1 row (trigger)&lt;br&gt;order_offers: none – dispatch starts only after ACCEPTED" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u1-root1"><mxGeometry x="1240" y="80" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="u1-note1" value="&lt;b&gt;Races – exactly one transition wins&lt;/b&gt;&lt;br&gt;• Reject vs customer cancel (T9): both WHERE status = PLACED; loser gets 409; one void row.&lt;br&gt;• Reject vs accept (two devices): one wins, the other device gets 409 and re-renders.&lt;br&gt;• Owner reject vs sweeper: one wins; ends REJECTED either way.&lt;br&gt;• Double tap / retry: 0 rows → re-read → already REJECTED by same restaurant → 200.&lt;br&gt;• Crash after COMMIT: outbox row survives, another instance sends it.&lt;br&gt;• Stripe down: void retried with the same idempotency key; “already canceled” = success." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u1-root1"><mxGeometry x="1240" y="240" width="380" height="210" as="geometry"/></mxCell>
        <mxCell id="u1-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 cart after rejection: gone · &lt;b&gt;restore cart&lt;/b&gt; · restore + suggestions&lt;br&gt;Q2 customer sees: free text · &lt;b&gt;friendly text from reason code&lt;/b&gt; · nothing&lt;br&gt;Q3 out_of_stock: nothing · &lt;b&gt;tick items to disable&lt;/b&gt; · disable all items&lt;br&gt;Q4 repeated timeouts: nothing · &lt;b&gt;auto-pause after 2 + incident&lt;/b&gt; · auto-close&lt;br&gt;Q5 accept after deadline: &lt;b&gt;refused (409)&lt;/b&gt; · first commit wins" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u1-root1"><mxGeometry x="1240" y="470" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="u1-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;T-numbers = docs/design/notes/order-state-machine.md · M-numbers = happy-path.drawio&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u1-root1"><mxGeometry x="1240" y="640" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="u2" name="2 · Courier declines">
