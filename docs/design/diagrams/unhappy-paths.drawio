        <mxCell id="u5-lane-K" value="Courier" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf6fc;" vertex="1" parent="u5-root1"><mxGeometry x="580" y="80" width="240" height="1356" as="geometry"/></mxCell>
        <mxCell id="u5-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="u5-root1"><mxGeometry x="820" y="80" width="300" height="1356" as="geometry"/></mxCell>
        <mxCell id="u5-lane-S" value="System (API · workers · DB) + Stripe" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="u5-root1"><mxGeometry x="1120" y="80" width="440" height="1356" as="geometry"/></mxCell>
        <mxCell id="u5-1" value="Tap “Cancel checkout”&lt;br&gt;(disabled while Stripe.js is confirming)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="130.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-2" value="&lt;b&gt;T5&lt;/b&gt; lock order · → CANCELLED WHERE status = PENDING_PAYMENT&lt;br&gt;AND customer_id = me · outbox payment.void · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u5-lane-S"><mxGeometry x="20" y="130.0" width="400" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u5-3" value="Back to the cart (restored)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="198.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-4" value="&lt;i&gt;Stripe (external)&lt;/i&gt;&lt;br&gt;PaymentIntent canceled&lt;br&gt;(no hold yet, or hold released)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="u5-lane-S"><mxGeometry x="20" y="316.0" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-5" value="Late authorization webhook after the cancel → T3 matches 0 rows&lt;br&gt;→ compensating payment.void with the same idempotency key" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u5-lane-S"><mxGeometry x="20" y="384.0" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-6" value="Tap Cancel → confirm&lt;br&gt;optional reason" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="488.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-7" value="&lt;b&gt;T9&lt;/b&gt; lock order · → CANCELLED WHERE status = PLACED&lt;br&gt;AND customer_id = me · outbox void + events · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u5-lane-S"><mxGeometry x="20" y="488.0" width="400" height="256.0" as="geometry"/></mxCell>
        <mxCell id="u5-8" value="“Cancelled – you have not been charged”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="556.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-9" value="Order leaves the incoming list,&lt;br&gt;alert sound stops" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u5-lane-R"><mxGeometry x="30" y="624.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-10" value="Board updated" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u5-lane-A"><mxGeometry x="12" y="692.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-11" value="Tap Cancel" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="796.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-12" value="Guard fails: status is now ACCEPTED&lt;br&gt;0 rows → ROLLBACK, re-read" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u5-lane-S"><mxGeometry x="20" y="796.0" width="400" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u5-13" value="“The restaurant already started.&lt;br&gt;Need help? Chat with support”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="864.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-14" value="Tap Cancel" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="968.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-15" value="&lt;b&gt;T18&lt;/b&gt; lock order · → CANCELLED WHERE status IN (ACCEPTED, READY_FOR_PICKUP)&lt;br&gt;AND dispatch_state = no_courier AND courier_id IS NULL&lt;br&gt;withdraw pending offer · resolve incident · outbox void · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u5-lane-S"><mxGeometry x="20" y="968.0" width="400" height="324.0" as="geometry"/></mxCell>
        <mxCell id="u5-16" value="“Cancelled – not charged”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u5-lane-C"><mxGeometry x="30" y="1036.0" width="230" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-17" value="“Cancelled – no courier found”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u5-lane-R"><mxGeometry x="30" y="1104.0" width="190" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-18" value="Offer card removed&lt;br&gt;(if one was pending)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="u5-lane-K"><mxGeometry x="30" y="1172.0" width="180" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-19" value="Incident resolved" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u5-lane-A"><mxGeometry x="12" y="1240.0" width="200" height="52" as="geometry"/></mxCell>
        <mxCell id="u5-ph0" value="Cancel is shown only in: PENDING_PAYMENT · PLACED · no courier found (dispatch_state = no_courier, no courier)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="134" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u5-ph1" value="A · During checkout – PENDING_PAYMENT (T5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="170" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u5-ph2" value="B · Waiting for the restaurant – PLACED (T9)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="528" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u5-ph3" value="B' · The restaurant accepted a moment earlier (race lost)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="836" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u5-ph4" value="C · No courier found (T18, decided in flow 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="1008" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u5-ph5" value="After commit (all branches) – outbox worker on any instance voids the authorization (as in flow 1, U7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="1384" width="1520" height="28" as="geometry"/></mxCell>
        <mxCell id="u5-e0" value="Z1 · POST /api/orders/:id/cancel" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-1" target="u5-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e1" value="Z2 · 200 {status: CANCELLED}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-2" target="u5-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e2" value="Z3 · outbox → paymentIntents.cancel&lt;br&gt;idempotency key order:{id}:void" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-2" target="u5-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e3" value="Z4 · POST /api/orders/:id/cancel {reason}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1016;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-6" target="u5-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e4" value="Z5 · 200 {status: CANCELLED}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.3672;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-7" target="u5-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e5" value="Z6 · ⚡ order.updated · CANCELLED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.6328;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-7" target="u5-9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e6" value="Z7 · ⚡&lt;br&gt;order.updated" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8984;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-7" target="u5-10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e7" value="Z8 · POST /api/orders/:id/cancel" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-11" target="u5-12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e8" value="Z9 · 409 {status: ACCEPTED}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;endArrow=open;endFill=0;fontColor=#b85450;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-12" target="u5-13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e9" value="Z10 · POST /api/orders/:id/cancel" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0802;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-14" target="u5-15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e10" value="Z11 · 200 – or 409 if a courier just accepted" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.2901;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-15" target="u5-16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e11" value="Z12 · ⚡ order.updated · CANCELLED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-15" target="u5-17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e12" value="Z13 · ⚡ offer.closed&lt;br&gt;{offerId, reason: withdrawn}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7099;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-15" target="u5-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-e13" value="Z14 · ⚡&lt;br&gt;incident.resolved" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.9198;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u5-root1" source="u5-15" target="u5-19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u5-title" value="Unhappy path 5 – Customer cancels (T5 checkout · T9 waiting for restaurant · T18 no courier)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="u5-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u5-note0" value="&lt;b&gt;What changes&lt;/b&gt;&lt;br&gt;T5: PENDING_PAYMENT → CANCELLED&lt;br&gt;T9: PLACED → CANCELLED&lt;br&gt;T18: ACCEPTED / READY_FOR_PICKUP → CANCELLED (no courier only)&lt;br&gt;cancelled_by = customer · cancel_reason = code or no_courier&lt;br&gt;payment_status → voided (after Stripe confirms)&lt;br&gt;order_offers: pending offer → withdrawn (T18) · incident resolved (T18)&lt;br&gt;order_status_history: 1 row" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u5-root1"><mxGeometry x="1600" y="80" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="u5-note1" value="&lt;b&gt;Races – one wins&lt;/b&gt;&lt;br&gt;• Cancel vs restaurant accept: both need status = PLACED → loser gets 409.&lt;br&gt;• Cancel vs accept-deadline sweeper (auto-reject): one terminal status, one void.&lt;br&gt;• Cancel vs authorization webhook: webhook loses → compensating void.&lt;br&gt;• Cancel vs payment-expiry sweeper: CANCELLED or EXPIRED, one void.&lt;br&gt;• T18 cancel vs courier accept: both lock the order; courier_id IS NULL guard → one wins.&lt;br&gt;• Double tap / retry: already CANCELLED by this customer → 200." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u5-root1"><mxGeometry x="1600" y="270" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="u5-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 confirm: one tap · &lt;b&gt;confirm dialog + optional reason&lt;/b&gt; · required reason&lt;br&gt;Q2 cart after cancel: gone · &lt;b&gt;restored&lt;/b&gt; · ask the customer&lt;br&gt;Q3 after the cutoff: hide the button · &lt;b&gt;hide it + “Chat with support” prefilled with the order&lt;/b&gt; · “request cancellation” to the restaurant" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u5-root1"><mxGeometry x="1600" y="490" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="u5-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;T-numbers = order transitions (T18 added in flow 4)&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u5-root1"><mxGeometry x="1600" y="640" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="u6" name="6 · Payment fails or retried">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2114" math="0" shadow="0">
      <root>
        <mxCell id="u6-root0"/>
        <mxCell id="u6-root1" parent="u6-root0"/>
        <mxCell id="u6-lane-C" value="Customer" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="80" width="300" height="1994" as="geometry"/></mxCell>
        <mxCell id="u6-lane-R" value="Restaurant owner" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f6fbf5;" vertex="1" parent="u6-root1"><mxGeometry x="340" y="80" width="240" height="1994" as="geometry"/></mxCell>
        <mxCell id="u6-lane-A" value="Admin" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="u6-root1"><mxGeometry x="580" y="80" width="310" height="1994" as="geometry"/></mxCell>
        <mxCell id="u6-lane-S" value="System (API · workers · DB) + Stripe" style="swimlane;horizontal=1;startSize=40;html=1;collapsible=0;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="u6-root1"><mxGeometry x="890" y="80" width="450" height="1994" as="geometry"/></mxCell>
        <mxCell id="u6-1" value="Enter card, tap Pay&lt;br&gt;(test card 4000 0000 0000 0002)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="130.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-2" value="&lt;i&gt;Stripe (external)&lt;/i&gt;&lt;br&gt;Issuer declines&lt;br&gt;PaymentIntent → requires_payment_method" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="130.0" width="410" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u6-3" value="Error shown at once:&lt;br&gt;“Your card was declined”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="198.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-4" value="&lt;b&gt;T2&lt;/b&gt; webhook payment_intent.payment_failed · dedupe by event id&lt;br&gt;last_payment_error, payment_attempts + 1 WHERE status = PENDING_PAYMENT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="310.0" width="410" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u6-5" value="Other devices show the error too" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="378.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-6" value="5th failed attempt → EXPIRED early + void · cart restored" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="446.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-7" value="Enter another card, Pay again&lt;br&gt;(button disabled while confirming)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="550.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-8" value="&lt;i&gt;Stripe (external)&lt;/i&gt;&lt;br&gt;Authorized (hold placed)&lt;br&gt;PaymentIntent → requires_capture" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="550.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-9" value="&lt;b&gt;T3&lt;/b&gt; webhook amount_capturable_updated · dedupe · amount check&lt;br&gt;→ PLACED WHERE status = PENDING_PAYMENT · accept_deadline · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="662.0" width="410" height="188.0" as="geometry"/></mxCell>
        <mxCell id="u6-10" value="Status: waiting for the restaurant" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="730.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-11" value="New order alert" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="u6-lane-R"><mxGeometry x="30" y="798.0" width="180" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-12" value="Reopen the app" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="902.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-13" value="Return the order as it is now&lt;br&gt;(PLACED, PENDING_PAYMENT or EXPIRED)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="902.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-14" value="Tap Pay again → app re-sends&lt;br&gt;the saved Idempotency-Key" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="970.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-15" value="&lt;b&gt;T1&lt;/b&gt; conflict on (customer_id, idempotency_key)&lt;br&gt;→ same order, same clientSecret · no second PaymentIntent" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="970.0" width="410" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u6-16" value="Continue paying the same order" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="1038.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-17" value="Reconciliation sweeper · PENDING_PAYMENT for &amp;gt; 2 min → paymentIntents.retrieve&lt;br&gt;requires_capture → apply T3 · requires_payment_method → leave · canceled → T4" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1142.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-18" value="&lt;b&gt;T4&lt;/b&gt; sweeper: PENDING_PAYMENT AND payment_expires_at &amp;lt;= now()&lt;br&gt;→ EXPIRED · outbox payment.void · COMMIT" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1246.0" width="410" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u6-19" value="“Checkout expired – your cart is saved”" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="u6-lane-C"><mxGeometry x="30" y="1314.0" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-20" value="&lt;i&gt;Stripe (external)&lt;/i&gt;&lt;br&gt;PaymentIntent canceled" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1426.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-21" value="Authorization lands after expiry → T3 matches 0 rows&lt;br&gt;→ compensating payment.void with the same key" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1494.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-22" value="&lt;b&gt;T13&lt;/b&gt; delivered → outbox payment.capture (key order:{id}:capture:1)&lt;br&gt;declined → retry 3× with backoff, new key per attempt (:2, :3)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1598.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-23" value="Still failing → payment_status = capture_failed&lt;br&gt;incident capture_failed · the order stays DELIVERED" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1666.0" width="410" height="120.0" as="geometry"/></mxCell>
        <mxCell id="u6-24" value="Incident: capture failed" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u6-lane-A"><mxGeometry x="12" y="1734.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-25" value="Retry capture" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="u6-lane-A"><mxGeometry x="12" y="1802.0" width="210" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-26" value="WHERE payment_status = capture_failed AND version = $seen&lt;br&gt;outbox payment.capture with the next attempt key" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1802.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-27" value="&lt;i&gt;Stripe (external)&lt;/i&gt;&lt;br&gt;Captured → payment_status = captured&lt;br&gt;incident resolved" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=11;fillColor=#eef2fb;strokeColor=#3d5a99;dashed=1;fontColor=#1f3466;" vertex="1" parent="u6-lane-S"><mxGeometry x="20" y="1914.0" width="410" height="52" as="geometry"/></mxCell>
        <mxCell id="u6-ph0" value="Start: T1 done · status PENDING_PAYMENT · PaymentIntent (manual capture) · payment_expires_at = now + 15 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="134" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-ph1" value="A · Card declined (T2 – the status does not change)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="170" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-ph2" value="B · Retry with another card – same order, same PaymentIntent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="590" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-ph3" value="C · Tab closed or network lost mid-payment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="942" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-ph4" value="D · Webhook late or lost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="1182" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-ph5" value="E · Payment window ends (T4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="1286" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-ph6" value="F · Capture fails after delivery – retried by the system, then by the admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#bbbbbb;opacity=85;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="1638" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="u6-e0" value="P1 · stripe.confirmCardPayment(clientSecret)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-1" target="u6-2"><mxGeometry relative="1" as="geometry"/></mxCell>
