        <mxCell id="u6-e4" value="P5 · stripe.confirmCardPayment(clientSecret)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-7" target="u6-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e5" value="P6 · webhook POST /api/webhooks/stripe" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-8" target="u6-9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e6" value="P7 · ⚡ order.updated · PLACED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-9" target="u6-10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e7" value="P8 · ⚡ order.new" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.8617;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-9" target="u6-11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e8" value="P9 · GET /api/orders/:id" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-12" target="u6-13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e9" value="P10 · POST /api/orders (same Idempotency-Key)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2167;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-14" target="u6-15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e10" value="P11 · 200 {orderId, clientSecret}" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-15" target="u6-16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e11" value="P12 · ⚡ order.updated · EXPIRED" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-18" target="u6-19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e12" value="P13 · paymentIntents.cancel (key order:{id}:void)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-18" target="u6-20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e13" value="P14 · ⚡&lt;br&gt;incident.opened" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6792b;endArrow=block;endFill=1;strokeWidth=1.5;fontColor=#8a4a10;exitX=0;exitY=0.7833;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-23" target="u6-24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e14" value="P15 · POST&lt;br&gt;…/retry-capture" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-25" target="u6-26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-e15" value="P16 · paymentIntents.capture (key order:{id}:capture:4)" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#3d5a99;endArrow=block;endFill=1;dashed=1;fontColor=#3d5a99;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="u6-root1" source="u6-26" target="u6-27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="u6-title" value="Unhappy path 6 – Payment fails or is retried (T2 · T3 · T4 · capture retry)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="u6-root1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="u6-note0" value="&lt;b&gt;What changes&lt;/b&gt;&lt;br&gt;T2: PENDING_PAYMENT stays · last_payment_error · payment_attempts + 1&lt;br&gt;T3: PENDING_PAYMENT → PLACED · payment_status authorized&lt;br&gt;T4: PENDING_PAYMENT → EXPIRED · payment_status voided&lt;br&gt;Capture: captured, or capture_failed + incident (order stays DELIVERED)&lt;br&gt;One PaymentIntent per order for its whole life&lt;br&gt;order_offers: none (dispatch starts after ACCEPTED)" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u6-root1"><mxGeometry x="1380" y="80" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="u6-note1" value="&lt;b&gt;Races and durability&lt;/b&gt;&lt;br&gt;• Success webhook vs expiry sweeper: one wins; late success → compensating void.&lt;br&gt;• Webhooks out of order (failed after success): failed handler needs PENDING_PAYMENT → no-op.&lt;br&gt;• Duplicate webhooks: stripe_events primary key → handled once.&lt;br&gt;• Webhook vs reconciliation sweeper: both conditional T3 → one transition.&lt;br&gt;• Double Pay click: button disabled + Stripe refuses a second confirm while processing.&lt;br&gt;• Stripe caches a failed result per idempotency key → a deliberate retry needs a new key (:2, :3).&lt;br&gt;• Any instance can take any webhook (raw body + signature check)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u6-root1"><mxGeometry x="1380" y="260" width="380" height="230" as="geometry"/></mxCell>
        <mxCell id="u6-note2" value="&lt;b&gt;Decisions&lt;/b&gt; (chosen option in bold)&lt;br&gt;Q1 failed attempts: until the 15 min window ends · &lt;b&gt;expire after 5 failures&lt;/b&gt; · after 3&lt;br&gt;Q2 lost webhooks: rely on Stripe's retries · &lt;b&gt;reconciliation sweeper after 2 min&lt;/b&gt; · trust the client&lt;br&gt;Q3 capture fails: log only · &lt;b&gt;3 automatic retries, then incident + admin retry&lt;/b&gt; · send the customer a payment link" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u6-root1"><mxGeometry x="1380" y="510" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="u6-note3" value="&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;&lt;b&gt;━━▶&lt;/b&gt; HTTP API call&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; HTTP response&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -▷&lt;/b&gt;&lt;/font&gt; error response (409)&lt;br&gt;&lt;font color=&quot;#d6792b&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; ⚡ socket.io event&lt;br&gt;&lt;font color=&quot;#3d5a99&quot;&gt;&lt;b&gt;- - -▶&lt;/b&gt;&lt;/font&gt; external service (Stripe, email)&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt;&lt;br&gt;Dashed grey box = depends on an open question (Q#)&lt;br&gt;&lt;br&gt;T-numbers = order transitions · test cards from Stripe test mode&lt;br&gt;&lt;i&gt;Endpoint paths and event names are proposals.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="u6-root1"><mxGeometry x="1380" y="670" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
