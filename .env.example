/*
    PORT - if not set then the default port will be 3000
    DB_HOST=
    DB_PORT=
    DB_NAME=
    DB_USER=
    DB_PASSWORD=
    JWT_SECRET=
    RATE_LIMIT_DISABLED=
    Public address of the frontend as the browser sees it (the nginx address, not the API port).
    Used to build the links in activation and password reset emails: ${FRONTEND_URL}/activate#token=...
    Development: http://localhost:8080   Production: https://<your-domain>
    FRONTEND_URL=
    OSM_USER_AGENT=BiteFetch/0.1 (https://github.com/<your-username>/bitefetch-api)
    # .env.example (and .env)
    # ISO country codes the OSM search is limited to. All of them share Romania's
    # time zone (EET/EEST), which the opening-hours check assumes (Europe/Bucharest).
    OSM_COUNTRIES=ro,bg,gr,cy,fi,ee,lv,lt,md
    DB_NAME_TEST - database used when NODE_ENV=test (bitefetch_db_test)
    DB_NAME_TEST=
    NODE_ENV - development / test / production. production makes the refresh cookie Secure (HTTPS only)
    and the logs plain JSON; test switches the database to DB_NAME_TEST
    NODE_ENV=
    LOG_LEVEL - if not set then info
    LOG_LEVEL=
    OSM_MIN_GAP_MS - minimum gap between Nominatim requests, if not set then 1100 (Nominatim allows 1 req/s)
    OSM_MIN_GAP_MS=
    OSRM_BASE_URL - if not set then https://router.project-osrm.org
    OSRM_BASE_URL=
    OSRM_MIN_GAP_MS - minimum gap between OSRM requests, if not set then 1100 (set to 0 in tests)
    OSRM_MIN_GAP_MS=
*/