{
  "name": "bitefetch-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:auth": "jest --runInBand tests/integration/auth",
    "migrate:create": "node-pg-migrate create --config-file ./config/migrate.config.js",
    "migrate:up": "node-pg-migrate up --config-file ./config/migrate.config.js",
    "migrate:down": "node-pg-migrate down --config-file ./config/migrate.config.js",
    "migrate:redo": "node-pg-migrate redo --config-file ./config/migrate.config.js",
    "migrate:test:up": "node-pg-migrate up --config-file ./config/migrate.test.config.js",
    "migrate:test:down": "node-pg-migrate down --config-file ./config/migrate.test.config.js",
    "seed": "node seeds/seed.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
